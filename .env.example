# =========================================================================
# Astroloper v2 - shared environment variables
# Copy to .env and adjust for your local machine.
# Per-service overrides live in backend/.env and frontend/.env.
# =========================================================================

# --- Project identity ---
COMPOSE_PROJECT_NAME=astroloper
SITE_HOST=astroloper.localhost
SITE_URL=https://astroloper.localhost

# --- Postgres ---
POSTGRES_DB=astroloper
POSTGRES_USER=astroloper
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Traefik ---
# The external Docker network created and owned by your standalone Traefik stack.
TRAEFIK_NETWORK=web
# Name of the Traefik entrypoint to bind our routers to. This has to match a name
# declared in your Traefik command (e.g. --entrypoints.https.address=:443).
# Common alternatives: `web` / `websecure`, `http` / `https`, `insecure` / `secure`.
TRAEFIK_ENTRYPOINT=https
# Whether Traefik should terminate TLS on the router. Set to `false` if you bind
# to a plain-HTTP entrypoint (and change SITE_URL to http:// accordingly).
TRAEFIK_TLS=true
