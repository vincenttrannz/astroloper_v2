# Rendered by ansible/roles/app/tasks/main.yml for env={{ env_name }}
#
# Backend runtime config, injected into the backend container via `env_file:`
# in docker-compose.yml. DATABASE_URL / REDIS_URL are supplied separately by
# Compose interpolation (built from the top-level .env POSTGRES_* + service DNS).
DJANGO_SETTINGS_MODULE={{ django_settings_module }}
DJANGO_DEBUG={{ '1' if django_debug else '0' }}
DJANGO_SECRET_KEY={{ django_secret_key }}

WAGTAILADMIN_BASE_URL={{ site_url }}
SITE_HOST={{ domain }}
SITE_URL={{ site_url }}

DJANGO_SUPERUSER_USERNAME={{ django_superuser_username }}
DJANGO_SUPERUSER_EMAIL={{ django_superuser_email }}
DJANGO_SUPERUSER_PASSWORD={{ django_superuser_password }}

# Transactional email (SMTP relay). Only emitted when configured in
# group_vars/<env> (e.g. staging/prod Resend). When absent we deliberately
# leave these out so settings/base.py defaults apply (dev also relies on the
# docker-compose.dev.yml override EMAIL_HOST=mailpit / EMAIL_PORT=1025); this
# avoids injecting an empty EMAIL_PORT="" that would break the int cast.
{% if email_host is defined %}
EMAIL_HOST={{ email_host }}
EMAIL_PORT={{ (email_port | default(587)) | string }}
EMAIL_USE_TLS={{ '1' if (email_use_tls | default(true)) else '0' }}
EMAIL_USE_SSL={{ '1' if (email_use_ssl | default(false)) else '0' }}
EMAIL_HOST_USER={{ email_host_user | default('') }}
EMAIL_HOST_PASSWORD={{ email_host_password | default('') }}
{% endif %}
{% if default_from_email is defined %}
DEFAULT_FROM_EMAIL={{ default_from_email }}
{% endif %}
{% if contact_to_email is defined %}
CONTACT_TO_EMAIL={{ contact_to_email }}
{% endif %}

# AI agent proxy (Contact page /api/v2/agent/). Blank keeps it in mock mode.
AGENT_URL={{ agent_url | default('') }}
AGENT_API_KEY={{ agent_api_key | default('') }}
