# =========================================================================
# Frontend (Next.js) local overrides.
# =========================================================================

# Absolute URL used by the browser (image sources, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=https://astroloper.localhost

# Wagtail API base URL used for server-side fetches. Inside docker-compose
# this is http://backend:8000 (internal DNS). Outside docker, point at your
# local backend, e.g. http://localhost:8000.
WAGTAIL_API_URL=http://backend:8000

# Shared secret protecting the /api/preview route (must match the value the
# Wagtail admin sends when redirecting into headless preview).
WAGTAIL_PREVIEW_SECRET=change-me-in-local-env
