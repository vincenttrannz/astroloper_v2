# =========================================================================
# Backend (Wagtail + Django) local overrides.
# Values from the top-level .env are also loaded (via compose).
# =========================================================================

DJANGO_SETTINGS_MODULE=project.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-local-env-and-never-commit

# Absolute URL the CMS admin uses when generating preview / share links.
WAGTAILADMIN_BASE_URL=https://astroloper.localhost

# Hostname served by Traefik. Also used in ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS.
SITE_HOST=astroloper.localhost
SITE_URL=https://astroloper.localhost

# Bootstrap admin user (used by createsuperuser --noinput on first setup).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=admin

# Optional overrides (usually inherited from top-level .env)
# DATABASE_URL=postgres://astroloper:astroloper@db:5432/astroloper
# REDIS_URL=redis://redis:6379/0
